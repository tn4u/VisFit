# Raw datasets (ignore raw files except .gitkeep)
/data/raw/*
!/data/raw/.gitkeep

# NumPy arrays
*.npy
*.npz

# PyTorch / model checkpoints
*.pth
*.pt
*.ckpt

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter checkpoints
.ipynb_checkpoints/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Weights & Biases
wandb/
.wandb/

# OS files
.DS_Store
Thumbs.db
